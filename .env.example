# ---- PriceCharting ----
# Your 40-character token from pricecharting.com/subscriptions -> "API/Download".
PRICECHARTING_TOKEN=

# The Pokémon CSV download link from the same page (Legendary plan). Paste it exactly as shown.
# The app downloads it at most once per REFRESH_HOURS and never more than once every 10 minutes.
PRICECHARTING_CSV_URL=

# For offline development only: read the price CSV from a local file instead of the URL.
# PRICECHARTING_CSV_FILE=./sample/prices.csv

REFRESH_HOURS=24
POKEMON_ONLY=true

# ---- PSA population data (optional) ----
# Pop data can be imported by hand from the admin page (CSV), or pulled from an Apify actor.
APIFY_TOKEN=
APIFY_ACTOR=lulzasaur~psa-pop-scraper
# Name of the actor input field that takes a PSA pop set page URL.
APIFY_INPUT_KEY=setUrl

# ---- App ----
PORT=3000
# Long random string. Required for anything on /admin.html (refreshing prices, importing pop data).
ADMIN_TOKEN=
DATA_DIR=./data
